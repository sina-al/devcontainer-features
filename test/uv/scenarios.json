{
    "latest": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "uv": {
                "version": "latest"
            }
        },
        "remoteUser": "vscode"
    },
    "pinned": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "uv": {
                "version": "0.12.5"
            }
        },
        "remoteUser": "vscode"
    },
    "python": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "features": {
            "uv": {
                "version": "latest",
                "pythonVersions": "3.12,3.13",
                "defaultPython": "3.12",
                "pythonPreference": "only-managed"
            }
        },
        "remoteUser": "vscode"
    }
}
